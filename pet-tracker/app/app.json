{
  "expo": {
    "name": "Cat Tracker",
    "slug": "cat-tracker",
    "scheme": "cattracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eu.example.cattracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cat Tracker uses this phone's location to stand in for a cat's GPS collar while you test the app."
      }
    },
    "android": {
      "package": "eu.example.cattracker",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cat Tracker uses this phone's location to stand in for a cat's GPS collar while you test the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
