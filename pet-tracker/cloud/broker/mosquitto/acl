# Backend ingest service (certificate CN = pt-ingest)
user pt-ingest
topic read  pt/v1/+/telemetry
topic read  pt/v1/+/agnss/req
topic write pt/v1/+/down/#

# Every other identity is a tracker: it may only touch its OWN topics.
# %u = certificate CN = device id, so pt-A can never publish as pt-B.
pattern write pt/v1/%u/telemetry
pattern write pt/v1/%u/agnss/req
pattern read  pt/v1/%u/down/#
