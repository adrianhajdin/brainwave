# Copy to your platform's secret store - never commit real values.
MQTT_URL=mqtts://mqtt.tracker.example.eu:8883
MQTT_CLIENT_ID=pt-ingest-1
MQTT_SHARE_GROUP=ingest
MQTT_CA_FILE=/run/secrets/broker-ca.crt
MQTT_CERT_FILE=/run/secrets/pt-ingest.crt
MQTT_KEY_FILE=/run/secrets/pt-ingest.key

# Least-privilege role created by the migration (enable LOGIN out-of-band).
# Supabase pooler user format: <role>.<project-ref>
DATABASE_URL=postgres://telemetry_ingest.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_CA_FILE=/run/secrets/supabase-ca.crt
DATABASE_POOL_SIZE=5

# Optional: A-GNSS proxy (nRF Cloud Location Services, cloud-to-cloud)
NRF_CLOUD_LOCATION_BASE_URL=https://api.nrfcloud.com/v1/organizations/ORG_SLUG/projects/PROJECT_SLUG/location
NRF_CLOUD_OAT=
AGNSS_MIN_INTERVAL_S=600

HEALTH_PORT=8080
LOG_LEVEL=info
