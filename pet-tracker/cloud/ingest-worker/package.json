{
  "name": "pet-tracker-ingest-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Long-running MQTT subscriber: validates tracker telemetry and writes it to Supabase/PostGIS; proxies A-GNSS requests to nRF Cloud.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "mqtt": "^5.10.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  }
}
